{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.int.spec.ts",
    "src/**/__tests__/**",
    "dist"
  ],
  "references": [
    {
      "path": "../shared/tsconfig.build.json"
    },
    {
      "path": "../config/tsconfig.build.json"
    }
  ]
}
