traces/
screenshots/
snapshots/
playwright-report/
test-results/

# ---- Editors / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- Tooling caches ----
.eslintcache
*.local.json
