# Raja1 environment (development defaults are safe: dry-run, mock provider, test payments)
NODE_ENV=development
LOG_LEVEL=info

# ---- HTTP ----
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- datastores ----
DATABASE_URL=
# REDIS_URL=redis://localhost:6379

# ---- safety switches (keep dry-run in development) ----
DRY_RUN=true
MOCK_PROVIDER=true
PAYMENT_MODE=test
AUTO_BOOKING_GLOBAL=false

# ---- auth (change in production; >=24 chars, non-default) ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
PASSWORD_PEPPER=dev-pepper-change-me
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# ---- encryption key ring: JSON { keyId: base64(32 bytes) } ----
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEYS={"k1":"ERIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII="}
ACTIVE_KEY_ID=k1
LOOKUP_HASH_KEY=

# ---- admin API (proxy pool management; set a strong token outside development) ----
ADMIN_API_TOKEN=dev-admin-token-change-me

# ---- egress proxy pool (docs/proxy-pool.md; fail-closed: OFF by default) ----
EGRESS_MODE=OFF
PROXY_MIN_HEALTH_SCORE=0
PROXY_PROBE_INTERVAL_SECONDS=300
PROXY_LEASE_SECONDS=600

# ---- provider / scheduling ----
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MIN_INTERVAL_SECONDS=20
PROVIDER_MAX_REQUESTS_PER_MINUTE=30
SCHEDULER_TICK_MS=1000
SCHEDULER_LEASE_SECONDS=30
WORKER_CONCURRENCY=4

# ---- telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- operations ----
METRICS_ENABLED=true
EXPOSE_API_DOCS=true
